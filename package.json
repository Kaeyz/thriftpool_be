{
  "name": "thriftpool_be",
  "version": "1.0.0",
  "description": "This is the monorepo for Thriftpool backend services",
  "private": true,
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaeyz/thriftpool_be.git"
  },
  "bugs": {
    "url": "https://github.com/Kaeyz/thriftpool_be/issues"
  },
  "homepage": "https://github.com/Kaeyz/thriftpool_be#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "packages:install": "pnpm install --filter ./packages/config... --filter ./packages/core... --filter ./packages/email... --filter ./packages/runtime...",
    "com": "pnpm --filter ./apps/community"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
